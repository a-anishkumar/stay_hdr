<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1E293B"
    android:clipToOutline="true">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay Hydrated"
        android:textColor="#38BDF8"
        android:textStyle="bold"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hydrated: 0 / 2000 ml"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Streak: 0 Days ??"
        android:textColor="#34D399"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/widget_coach_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coach: Start with 300ml water"
        android:textColor="#C084FC"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />

    <Button
        android:id="@+id/btn_quick_add"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="#0284C7"
        android:textColor="#FFFFFF"
        android:text="+ 250ml Water"
        android:textSize="10sp"
        android:gravity="center" />
</LinearLayout>
